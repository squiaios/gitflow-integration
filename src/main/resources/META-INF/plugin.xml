<idea-plugin>
    <id>squiaios.gitflow</id>
    <name>GitFlow Pilot</name>
    <vendor>squiaios</vendor>

    <description><![CDATA[
    <p>Work with the <a href="https://nvie.com/posts/a-successful-git-branching-model/">git flow</a>
    branching model from inside the IDE - no <code>git flow</code> command line tool required.</p>
    <ul>
      <li><b>Initialize</b> git flow in a repository: production and development branches, branch
          prefixes and version tag prefix.</li>
      <li><b>Start</b> feature, bugfix, release, hotfix and support branches.</li>
      <li><b>Finish</b> them: merge back with or without fast-forward, squash or rebase for features and
          bugfixes; merge into production, tag and merge back into development for releases and hotfixes.</li>
      <li><b>Publish</b>, check out (tracking remote branches) and delete flow branches.</li>
      <li>A <b>Git Flow</b> tool window lists the flow branches of each repository.</li>
      <li>Conflicts stop the operation and open the IDE's merge tool; finish again to resume it.</li>
    </ul>
    <p>Everything is stored in the repository's git config, under the <code>gitflow.*</code> keys.</p>
    <p>Use <b>Git | Git Flow</b>, or the <b>Git Flow</b> tool window.</p>
    ]]></description>

    <change-notes><![CDATA[
    <b>1.0.0</b>
    <ul>
      <li>Initial release: init, start, finish, publish, check out and delete for feature, bugfix,
          release, hotfix and support branches.</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.GitFlowBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Git Flow" displayType="BALLOON" bundle="messages.GitFlowBundle" key="notification.group"/>

        <toolWindow id="Git Flow" anchor="left" secondary="true" icon="/icons/gitFlow.svg"
                    factoryClass="gitflow.integration.ide.ui.GitFlowToolWindowFactory"/>

        <statusBarWidgetFactory id="gitflow.integration.statusBar"
                                implementation="gitflow.integration.ide.ui.GitFlowStatusBarWidgetFactory"
                                order="after git"/>

        <projectConfigurable id="gitflow.integration.settings"
                             parentId="project.propVCSSupport.Mappings"
                             instance="gitflow.integration.ide.GitFlowConfigurable"
                             bundle="messages.GitFlowBundle" key="settings.title"/>
    </extensions>

    <actions>
        <action id="GitFlow.Init" class="gitflow.integration.ide.actions.InitAction"/>

        <action id="GitFlow.StartFeature" class="gitflow.integration.ide.actions.StartAction$Feature"/>
        <action id="GitFlow.StartBugfix" class="gitflow.integration.ide.actions.StartAction$Bugfix"/>
        <action id="GitFlow.StartRelease" class="gitflow.integration.ide.actions.StartAction$Release"/>
        <action id="GitFlow.StartHotfix" class="gitflow.integration.ide.actions.StartAction$Hotfix"/>
        <action id="GitFlow.StartSupport" class="gitflow.integration.ide.actions.StartAction$Support"/>

        <action id="GitFlow.Finish" class="gitflow.integration.ide.actions.FinishAction"
                icon="AllIcons.Actions.Commit"/>
        <action id="GitFlow.Publish" class="gitflow.integration.ide.actions.PublishAction"
                icon="AllIcons.Vcs.Push"/>

        <!-- Only meaningful on a branch selected in the tool window. -->
        <action id="GitFlow.Checkout" class="gitflow.integration.ide.actions.BranchActions$Checkout"/>
        <action id="GitFlow.Delete" class="gitflow.integration.ide.actions.BranchActions$Delete"
                icon="AllIcons.General.Remove"/>

        <!-- The list of git flow actions, shared by the menu, the toolbar popup and the status bar popup. -->
        <group id="GitFlow.Actions" searchable="false">
            <reference ref="GitFlow.Init"/>
            <separator/>
            <reference ref="GitFlow.StartFeature"/>
            <reference ref="GitFlow.StartBugfix"/>
            <reference ref="GitFlow.StartRelease"/>
            <reference ref="GitFlow.StartHotfix"/>
            <reference ref="GitFlow.StartSupport"/>
            <separator/>
            <reference ref="GitFlow.Finish"/>
            <reference ref="GitFlow.Publish"/>
        </group>

        <!-- Opens GitFlow.Actions as a popup menu: a plain action, because the branches popup only lists those. -->
        <action id="GitFlow.ShowMenu" class="gitflow.integration.ide.actions.ShowMenuAction"
                icon="/icons/gitFlow.svg">
            <add-to-group group-id="Git.Branches.List" anchor="last"/>
        </action>

        <!-- The same, as a button of the main toolbar, with the icon at the size the toolbar expects. -->
        <action id="GitFlow.ToolbarButton" class="gitflow.integration.ide.actions.ShowMenuAction"
                icon="/icons/gitFlowToolbar.svg">
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="SearchEverywhere"/>
        </action>

        <!-- Drop-down used by the tool window's toolbar. -->
        <group id="GitFlow.StartMenu" popup="true" icon="AllIcons.General.Add" searchable="false">
            <reference ref="GitFlow.StartFeature"/>
            <reference ref="GitFlow.StartBugfix"/>
            <reference ref="GitFlow.StartRelease"/>
            <reference ref="GitFlow.StartHotfix"/>
            <reference ref="GitFlow.StartSupport"/>
        </group>

        <!-- Git | Git Flow -->
        <group id="GitFlow.Menu" popup="true" icon="/icons/gitFlow.svg">
            <reference ref="GitFlow.Actions"/>
            <add-to-group group-id="Git.MainMenu" anchor="before" relative-to-action="Git.Configure.Remotes"/>
        </group>

        <group id="GitFlow.ToolWindow.Popup">
            <reference ref="GitFlow.Checkout"/>
            <reference ref="GitFlow.Finish"/>
            <reference ref="GitFlow.Publish"/>
            <separator/>
            <reference ref="GitFlow.Delete"/>
        </group>
    </actions>
</idea-plugin>
